{
  "name": "stockroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/tailwind.css -o assets/tailwind.css --minify",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tailwindcss": "^3.4.19"
  }
}
